# ==============================================================================
# UK Wind Forecast Analysis - Docker Compose Environment Configuration
# Copy this file to `.env` in the repository root to customize local settings:
#   cp .env.example .env
# ==============================================================================

# Ports exposed on host machine
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Backend API base URL accessed by the user's browser
# In local Docker development, use http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Backend Application Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO

# Elexon BMRS API Endpoints
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
FUELHH_STREAM_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/FUELHH/stream
WINDFOR_STREAM_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/WINDFOR/stream

# Procurement Analysis Default Configuration
DEFAULT_START_DATE=2026-01-01
DEFAULT_END_DATE=2026-01-31
DEFAULT_DAY_AHEAD_CUTOFF_HOUR=12

# HTTP Client & Resilience
HTTP_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5

# CORS Configuration for Frontend Browser Access
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80","http://127.0.0.1:5173","http://127.0.0.1:3000","http://127.0.0.1:80"]
