# UK Wind Forecast Analysis - Backend Environment Configuration

# Application
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Elexon BMRS API Endpoints
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
FUELHH_STREAM_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/FUELHH/stream
WINDFOR_STREAM_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/WINDFOR/stream

# Procurement Analysis Default Configuration
DEFAULT_START_DATE=2026-01-01
DEFAULT_END_DATE=2026-01-31
# Day-ahead gate closure / decision cutoff hour in UTC (e.g., 12 for 12:00 UTC day-ahead)
DEFAULT_DAY_AHEAD_CUTOFF_HOUR=12

# HTTP Client & Resilience
HTTP_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5

# CORS Configuration for Frontend Integration (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
